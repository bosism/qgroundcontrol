<RCC>
    <qresource prefix="/Custom/qmlimages">
        <file alias="PaperPlane.svg">res/Images/CustomVehicleIcon.svg</file>
    </qresource>
    <qresource prefix="/Custom/qml">
        <file alias="QGroundControl/FlyView/FlyViewBottomRightRowLayout.qml">src/FlyViewBottomRightRowLayout.qml</file>
        <file alias="QGroundControl/FlyView/FlyViewCustomLayer.qml">src/FlyViewCustomLayer.qml</file>
        <file alias="QGroundControl/FlyView/FlyViewToolStripActionList.qml">src/FlyViewToolStripActionList.qml</file>
        <file alias="QGroundControl/Toolbar/SelectViewDropdown.qml">src/SelectViewDropdown.qml</file>
        <file alias="QGroundControl/AppSettings/SettingsPagesModel.qml">src/SettingsPagesModel.qml</file>
    </qresource>
    <qresource prefix="/Custom/fonts">
        <file alias="BarlowCondensed-Medium.ttf">res/fonts/BarlowCondensed-Medium.ttf</file>
        <file alias="BarlowCondensed-SemiBold.ttf">res/fonts/BarlowCondensed-SemiBold.ttf</file>
        <file alias="ShareTechMono-Regular.ttf">res/fonts/ShareTechMono-Regular.ttf</file>
    </qresource>
    <qresource prefix="/Custom/res">
        <file alias="QGCLogoFull.svg">res/Images/QGCLogoFull.svg</file>
        <file alias="qgroundcontrol.ico">res/icons/custom_qgroundcontrol.ico</file>
    </qresource>
</RCC>
